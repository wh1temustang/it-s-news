<figure class="meme dt">
  <div class="dt-scene" aria-hidden="true">
    <div class="dt-fig dt-fig--new"><span class="dt-emoji">💃</span><span class="dt-tag caption">{{ data.new }}</span></div>
    <div class="dt-fig dt-fig--who"><span class="dt-emoji">😍</span><span class="dt-tag caption">{{ data.who }}</span></div>
    <div class="dt-fig dt-fig--old"><span class="dt-emoji">😠</span><span class="dt-tag caption">{{ data.old }}</span></div>
  </div>
  <figcaption class="sr-only">{{ t("distracted.summary", who=data.who, old=data.old, new=data.new) }}</figcaption>
</figure>
