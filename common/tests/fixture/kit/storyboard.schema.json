{
  "title": "Storyboard",
  "type": "object",
  "required": ["headline", "scenes"],
  "additionalProperties": false,
  "properties": {
    "headline": {
      "type": "object",
      "required": ["title", "dek", "topic"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "dek": {"type": "string", "minLength": 1, "maxLength": 160},
        "topic": {"type": "string", "enum": ["world", "local", "tech"]}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["template", "question", "data"],
        "additionalProperties": false,
        "properties": {
          "template": {"type": "string"},
          "question": {"type": "string", "minLength": 1, "maxLength": 60},
          "data": {"type": "object"}
        }
      }
    },
    "bottom_line": {"type": "string", "maxLength": 200}
  }
}
