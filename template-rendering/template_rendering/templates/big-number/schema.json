{
  "title": "Big number",
  "x-icon": "🔢",
  "description": "When one to three numbers are the news themselves.",
  "type": "object",
  "required": ["numbers"],
  "additionalProperties": false,
  "properties": {
    "numbers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "The headline number first.",
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 14,
            "description": "The number with its unit, as the article writes it: \"3.2%\", \"$48M\", \"1,200\"."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "What the number counts, in a few words."
          },
          "context": {
            "type": "string",
            "maxLength": 50,
            "description": "Optional comparison: \"up from 2.9% in May\"."
          },
          "trend": {
            "type": "string",
            "enum": ["up", "down", "flat"],
            "description": "Optional arrow for a number that changed. It shows direction only, not good or bad."
          }
        }
      }
    }
  }
}
