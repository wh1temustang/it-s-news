{# Voices: one cartoon figure and speech bubble per stakeholder. The
   figure is a role symbol from a fixed set — never a likeness of the
   person. The bubble holds a verbatim quote or one grounded line on
   where they stand. #}
<div class="vc">
  {% for voice in data.voices %}
  <div class="vc-voice">
    <svg class="vc-fig vc-{{ voice.character }}" viewBox="0 0 96 96" role="img" aria-label="{{ voice.name }}">
      <circle class="vc-head" cx="48" cy="32" r="17" />
      <path class="vc-body" d="M20 88 Q20 58 48 58 Q76 58 76 88 Z" />
      {% if voice.character == "worker" %}
      <path class="vc-prop" d="M28 30 Q28 12 48 12 Q68 12 68 30 L74 30 L74 36 L22 36 L22 30 Z" />
      {% elif voice.character == "executive" %}
      <path class="vc-prop" d="M48 60 L56 70 L48 88 L40 70 Z" />
      {% elif voice.character == "official" %}
      <circle class="vc-prop" cx="63" cy="72" r="7" />
      <circle class="vc-prop-dot" cx="63" cy="72" r="3" />
      {% elif voice.character == "judge" %}
      <g class="vc-prop"><rect x="62" y="18" width="22" height="10" rx="2" /><rect x="70" y="28" width="5" height="26" rx="2" /></g>
      {% elif voice.character == "scientist" %}
      <path class="vc-prop" d="M74 38 h8 v14 l10 20 a6 6 0 0 1 -6 8 h-16 a6 6 0 0 1 -6 -8 l10 -20 Z" />
      {% elif voice.character == "resident" %}
      <path class="vc-prop" d="M60 52 L72 40 L84 52 V68 H60 Z" />
      {% elif voice.character == "activist" %}
      <g class="vc-prop"><rect x="70" y="14" width="3" height="36" rx="1" /><rect x="58" y="6" width="26" height="16" rx="2" /></g>
      {% elif voice.character == "farmer" %}
      <path class="vc-prop" d="M30 22 Q30 8 48 8 Q66 8 66 22 L74 22 Q74 28 66 28 L30 28 Q22 28 30 22 Z" />
      {% endif %}
    </svg>
    <div class="vc-bubble">
      <p>{{ voice.quote if voice.quote is defined else voice.stance }}</p>
      <footer class="vc-by"><b>{{ voice.name }}</b>{% if voice.role is defined %} <span>{{ voice.role }}</span>{% endif %}</footer>
    </div>
  </div>
  {% endfor %}
</div>
