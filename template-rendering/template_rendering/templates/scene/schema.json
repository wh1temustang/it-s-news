{
  "additionalProperties": false,
  "description": "An animated, reactive illustrated scene: the robot pictures the story's beat, so a boring story is worth looking at. The storyboard stages any beat with simple shapes — the template provides the robot, the backdrop, the animation wiring and the slider — and the reader scrubs the beat or turns a scale up to the article number. The scene is general: there is no fixed list of beats. Shapes are layout, not facts, so their geometry is x-ungrounded; only the label, stage lines, shape text and the scale number are checked against the article.",
  "properties": {
    "backdrop": {
      "default": "none",
      "description": "The full-bleed background the template draws: a stormy sky or a dark room. 'none' leaves the page surface showing.",
      "enum": [
        "none",
        "room",
        "sky"
      ],
      "type": "string"
    },
    "character": {
      "description": "Which character stands in the scene. The template draws the robot; include a robot shape to place it and move it, or it renders last, on top.",
      "enum": [
        "robot"
      ],
      "type": "string"
    },
    "label": {
      "description": "What the scene is about, in a few words: \"Rainfall in 36 hours\" or \"He resigned before they could oust him\". Any number in it must appear in the article.",
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
    },
    "scale": {
      "additionalProperties": false,
      "description": "When the scene turns a number up: the slider runs from 0 to the article number and the readout shows it live. Leave it out for a beat the reader scrubs through instead.",
      "properties": {
        "max_value": {
          "description": "The article number the slider tops out at: the rainfall in millimetres, the rate in percent. It must appear in the article.",
          "type": "number"
        },
        "start_fraction": {
          "default": 0.4,
          "description": "Where the slider starts, as a fraction of the maximum. A design choice, not a fact from the article, so the checker does not verify it.",
          "maximum": 1,
          "minimum": 0,
          "type": "number",
          "x-ungrounded": true
        },
        "unit": {
          "description": "The unit shown with the value: \" mm\" or \"%\".",
          "maxLength": 8,
          "minLength": 1,
          "type": "string"
        },
        "unit_after": {
          "description": "True when the unit goes after the number (\"210 mm\"), false when it goes before (\"$210\").",
          "type": "boolean"
        }
      },
      "required": [
        "max_value",
        "unit"
      ],
      "type": "object"
    },
    "shapes": {
      "description": "The scene itself, as simple shapes in a 400 by 300 viewBox, drawn in order — later shapes sit on top. Geometry is layout, not fact: coordinates, colours and moves are x-ungrounded and the checker does not verify them. Only shape text is checked, like any other words on the page. A shape has either 'anim' (a looping ambient motion) or 'moves' (keyframes the slider drives), not both. Author every shape in its state at t=0; the slider moves it from there.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "description": "Text alignment for a text shape.",
            "enum": [
              "end",
              "middle",
              "start"
            ],
            "type": "string",
            "x-ungrounded": true
          },
          "anim": {
            "description": "A looping ambient motion: bob (up and down), wobble (a small rock), fall (drops falling, with speed), ripple (a ring growing and fading).",
            "enum": [
              "bob",
              "fall",
              "ripple",
              "wobble"
            ],
            "type": "string",
            "x-ungrounded": true
          },
          "children": {
            "description": "Shapes inside a group, drawn in order. A group moves as one: give the group 'moves' and its children ride along. Children are leaf shapes only — no groups inside groups, no robot inside a group.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "anchor": {
                  "enum": [
                    "end",
                    "middle",
                    "start"
                  ],
                  "type": "string",
                  "x-ungrounded": true
                },
